+#ifdef _WIN32
+namespace
+{
+    // Minimal layouts of the loader structures, used to walk the module list ourselves instead of
+    // relying on K32EnumProcessModules.
+    struct UnicodeStringLayout
+    {
+        USHORT Length;
+        USHORT MaximumLength;
+        PWSTR Buffer;
+    };
+
+    struct LdrTableEntryLayout
+    {
+        LIST_ENTRY InLoadOrderLinks;
+        LIST_ENTRY InMemoryOrderLinks;
+        LIST_ENTRY InInitializationOrderLinks;
+        void* DllBase;
+        void* EntryPoint;
+        ULONG SizeOfImage;
+        ULONG Padding0;
+        UnicodeStringLayout FullDllName;
+        UnicodeStringLayout BaseDllName;
+    };
+
+    struct PebLdrDataLayout
+    {
+        ULONG Length;
+        BOOLEAN Initialized;
+        BYTE Padding0[3];
+        PVOID SsHandle;
+        LIST_ENTRY InLoadOrderModuleList;
+        LIST_ENTRY InMemoryOrderModuleList;
+        LIST_ENTRY InInitializationOrderModuleList;
+    };
+
+    struct PebHeaderLayout
+    {
+        BYTE InheritedAddressSpace;
+        BYTE ReadImageFileExecOptions;
+        BYTE BeingDebugged;
+        BYTE BitField;
+        BYTE Padding0[4];
+        PVOID Mutant;
+        PVOID ImageBaseAddress;
+        PebLdrDataLayout* Ldr;
+    };
+
+    inline auto GetPebLayout() -> PebHeaderLayout*
+    {
+        return reinterpret_cast<PebHeaderLayout*>(__readgsqword(0x60));
+    }
+
+    // Converts an LDR entry base name to an ANSI string. Returns an empty string on failure.
+    inline auto LdrEntryNameToAnsi(const UnicodeStringLayout& Name) -> std::string
+    {
+        if (Name.Buffer == nullptr || Name.Length == 0)
+        {
+            return {};
+        }
+
+        char Buffer[MAX_PATH]{};
+        const int Converted = WideCharToMultiByte(CP_ACP,
+                                                  0,
+                                                  Name.Buffer,
+                                                  static_cast<int>(Name.Length / sizeof(wchar_t)),
+                                                  Buffer,
+                                                  static_cast<int>(sizeof(Buffer) - 1),
+                                                  nullptr,
+                                                  nullptr);
+        if (Converted <= 0)
+        {
+            return {};
+        }
+
+        return std::string{Buffer, static_cast<size_t>(Converted)};
+    }
+} // namespace
+#endif
